# Copy this file to Cas12g_3rep_400ns.env and edit paths locally.
GMX=gmx
PYMOL=pymol
PYTHON=python3

# Supply your own approved structure; this repository intentionally contains no PDB.
WT_PDB=/absolute/path/to/Cas12g_WT.pdb
CHAIN=A
WORKDIR=/absolute/path/to/cas12g_md_results

VARIANTS="WT V623Q V623S"
# One server: "1 2 3". Three servers: use "1", "2", or "3" respectively.
REPLICATE_IDS="1 2 3"
BASE_SEED=20261020
REBUILD_MUTANTS=no

FORCEFIELD=amber99sb-ildn
WATER=tip3p
BOX_TYPE=dodecahedron
BOX_DIST_NM=1.0
SALT_MOLAR=0.15
TEMP_K=300
PRESSURE_BAR=1.0
PREPARE_PROTEIN_ONLY=yes

NVT_PS=100
NPT_CA_PS=1000
NPT_NOCA_PS=500
MD_NS=400
DT_PS=0.002
XTC_INTERVAL_PS=100
ENERGY_INTERVAL_PS=10
LOG_INTERVAL_PS=10
CHECKPOINT_MIN=15
MD_DEFFNM=md400
CA_FC=1000
MDRUN_CPU_OPTS="-nb cpu -pme cpu"
MDRUN_GPU_OPTS="-nb gpu -pme gpu"
MAXWARN=0
ION_MAXWARN=1

ANALYSIS_BEGIN_NS=50
FEL_BINS=30
CLEAN_INTERMEDIATES=no
